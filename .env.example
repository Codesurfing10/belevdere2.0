# PostgreSQL (required)
DATABASE_URL="postgresql://user:password@localhost:5432/belevdere"

# Mapbox (required for map + geocoding; leave blank and map may show empty)
MAPBOX_TOKEN="pk.your_mapbox_token_here"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Stripe — optional for public DEMO
# If STRIPE_SECRET_KEY is missing or a placeholder (sk_test_your_*, sk_test_placeholder),
# checkout runs in DEMO_MODE: marks the order paid and booking confirmed without Stripe.
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# PayPal Checkout (Orders API) — optional for public DEMO
# When PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET are missing or placeholders,
# "Pay with PayPal" runs in demo mode (simulate success, no charge).
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
# sandbox (default) or live
PAYPAL_MODE="sandbox"
# Public client id for the PayPal JS SDK (usually same as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_client_id"

# PayPal.me tip / support link in the footer (optional)
# Example: https://paypal.me/YourName
# If unset or placeholder, footer shows a disabled/demo note instead of a live link.
NEXT_PUBLIC_PAYPAL_ME_URL="https://paypal.me/your_paypal_me"

# Optional explicit flag (checkout also auto-detects missing/placeholder Stripe or PayPal keys)
# DEMO_MODE=true
